# Copy this file to .env and fill in your keys (never commit .env)

# Gnani Speech APIs (Prisma STT & Timbre v2.5 TTS)
GNANI_API_KEY=
GNANI_STT_LANGUAGE=hi-IN
GNANI_TTS_VOICE=Poorvi
GNANI_TTS_LANG=auto

# Groq LLM Extraction (Person B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Supabase Postgres (Person B)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

